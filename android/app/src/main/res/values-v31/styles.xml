<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 took the launch window away from windowBackground and gave it to the
     platform splash screen, which centres the *launcher icon* on it — so without
     these the app opened on the stock Flutter logo. The ground and the mark are the
     ones the Dart splash draws: white, with the purple mark. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
