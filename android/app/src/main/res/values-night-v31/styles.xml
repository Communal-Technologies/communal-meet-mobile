<?xml version="1.0" encoding="utf-8"?>
<!-- Identical to values-v31; see the note there. The launch window is brand-locked the
     way the wallet's and the collector's are — the Dart screen behind it is white
     whatever the system palette says, so a dark launch window would only flash a
     different colour on the way in. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
